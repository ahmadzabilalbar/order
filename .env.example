# --- Admin auth ---
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie (openssl rand -base64 32)
SESSION_SECRET=

# --- Google Sheets (leave empty to run in in-memory demo mode) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON, keeping the \n sequences
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Optional display settings ---
NEXT_PUBLIC_APP_NAME=Order Sini
NEXT_PUBLIC_CURRENCY=MYR
NEXT_PUBLIC_LOCALE=en-MY
NEXT_PUBLIC_TIMEZONE=Asia/Kuala_Lumpur
